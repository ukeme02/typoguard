{
  "manifest_version": 3,
  "name": "TypoGuard",
  "version": "0.1.0",
  "description": "Privacy-first browser extension for recovering long-form text after accidental loss.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TypoGuard Recovery"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["discovery.js", "safety.js", "capture.js", "storage.js", "content.js", "recovery-banner.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject-restore.js"],
      "run_at": "document_idle"
    }
  ]
}